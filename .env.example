DASHSCOPE_API_KEY='sk-******'
DASHSCOPE_API_BASE='https://dashscope.aliyuncs.com/compatible-mode/v1'

# production：禁用本地 kubectl/K3s 工具；evaluation/development：允许本地场景工具
ENV_FLAG=development

# 这组可以不填
DEEPSEEK_API_KEY='sk-******'
DEEPSEEK_BASE_URL='https://api.deepseek.com'

# 目前还能兼容老版SSE，现在主流都是用HTTP了
MCP_CLS_TRANSPORT=sse
MCP_CLS_URL=http://127.0.0.1:8003/sse
MCP_MONITOR_TRANSPORT=sse
MCP_MONITOR_URL=http://127.0.0.1:8004/sse

# Prometheus 与自动运维
PROMETHEUS_BASE_URL=http://your-prometheus-host:9090
AUTOMATION_ENABLED=true
AUTOMATION_ALERT_POLL_INTERVAL=60
AUTOMATION_PATROL_INTERVAL=3600
EXPERIENCE_EXTRACTION_ENABLED=true
EXPERIENCE_FILE=./data/通用经验.md
WARNING_LOGS_DIR=./data/warnning_log
SKILLS_DIR=./skills

# 默认关闭自动重启；启用前请配置明确的 systemd 服务白名单。
SERVICE_RESTART_ENABLED=false
MANAGED_HTTP_SERVICES='{"rag":"rag.service","8001":"endpoint.service","dblog-backend":"dblog-backend.service"}'
# 测试服务灰名单：优先于 MANAGED_HTTP_SERVICES 匹配；仅允许受控 restart/stop
MANAGED_HTTP_GREYLIST='{"demo-test":"demo-test.service"}'
SERVICE_STOP_ENABLED=false
SYSTEMD_MCP_URL=http://127.0.0.1:8006/mcp
